DATABASE_URL=              # Neon pooled connection string
DATABASE_URL_UNPOOLED=     # Neon direct connection string (migrations)
CRON_SECRET=               # long random string; same value in Apps Script properties
DASHBOARD_PASSWORD=
SESSION_SECRET=            # long random string
TG_BOT_TOKEN=              # from @BotFather
TG_CHAT_ID=                # your own chat id; the bot talks to nobody else
TG_WEBHOOK_SECRET=         # long random string (letters, digits, _ and - only)
SPLITWISE_API_KEY=         # secure.splitwise.com/apps -> register -> API key
GROQ_API_KEY=
TARGET_EQUITY_PCT=70       # optional: share of investments you want in equity
